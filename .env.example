# Authentication/session defaults. Production secrets must be supplied securely.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_REFRESH_TOKEN_TTL=24h

# Refresh tokens are issued only as HttpOnly cookies. Secure must remain true in
# production. Leave DOMAIN empty for a host-only cookie. SameSite may be lax
# or strict; cross-site cookie mode is intentionally unsupported without a
# dedicated CSRF-token design.
REFRESH_COOKIE_NAME=nodus_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Space-separated exact frontend origins. Credentialed CORS never supports '*'.
ALLOWED_ORIGINS=http://localhost:5173
