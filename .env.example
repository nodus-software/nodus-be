# Server

APP_ENV=development
APP_PORT=8080
BASE_URL=http://localhost:5173
TENANT_BASE_DOMAIN=localhost
TENANT_URL_SCHEME=http
TENANT_URL_PORT=5173
RESERVED_ORGANIZATION_SLUGS=
ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 https://nodushealth.com

# DB Main
# The API connects as nodus_app, a role with neither SUPERUSER nor BYPASSRLS.
# That is load-bearing, not hygiene: tenant scoping is enforced entirely by the
# tenant_isolation row-level security policies, which PostgreSQL skips for
# superusers — connect as the owner and every tenant's rows come back.
# Run `make db-role` to create it. Migrations still use the owner via
# MIGRATION_DB_URL (see the Makefile).
DB_OWNER=nodus
DB_OWNER_PASSWORD=nodus
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nodus_health
DB_USER=nodus_app
DB_PASSWORD=nodus
DB_SSL_MODE=disable
DB_URL=postgres://nodus_app:nodus@localhost:5433/nodus_health?sslmode=disable

# DB test
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=nodus_health_test
TEST_DB_USER=nodus
TEST_DB_PASSWORD=nodus
TEST_DB_SSL_MODE=disable
TEST_DB_URL=postgres://nodus:nodus@localhost:5433/nodus_health_test?sslmode=disable

# REDIS
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=dev-only-change-me-in-production-please-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Password hashing
BCRYPT_COST=12

# Password complexity policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_REJECT_COMMON=true
PASSWORD_MAX_AGE_DAYS=90

# MFA
TOTP_ISSUER=Nodus Health
MFA_BACKUP_CODE_COUNT=10
MFA_ENCRYPTION_KEY=TYkljjstkstjksjtsjklsj

# Lockout policy
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m

# Adaptive authentication security. Keep observation enabled until its metrics
# have been reviewed, then switch to enforcement without reverting schema.
AUTH_SECURITY_MODE=observation
AUTH_FAILURE_OBSERVATION_WINDOW=15m
AUTH_FAILURE_CYCLE_WINDOW=24h
AUTH_FAILURE_LOCK_THRESHOLD=10
AUTH_FAILURE_INITIAL_LOCK=15m
AUTH_FAILURE_MAXIMUM_LOCK=1h
AUTH_RATE_LIMIT_HMAC_SECRET=
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_IDENTIFIER_LIMIT=30
AUTH_RATE_LIMIT_IP_LIMIT=300
AUTH_RATE_LIMIT_TENANT_LIMIT=3000
AUTH_RATE_LIMIT_CONTEXT_LIMIT=100
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT=3s
TURNSTILE_TEST_TOKEN=development-turnstile-pass

# Unified self-service recovery
RECOVERY_EMAIL_TOKEN_TTL=10m
RECOVERY_SESSION_TTL=10m
RECOVERY_MAX_ATTEMPTS=5

# Transactional email. Configure both API keys to switch providers by changing
# only EMAIL_PROVIDER. Leave EMAIL_PROVIDER empty in local development to keep
# messages queued without attempting delivery.
EMAIL_PROVIDER=
EMAIL_FROM_NAME=Nodus Health
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_HTTP_TIMEOUT=10s
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_SEND_TOKEN=
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
EMAIL_LOGO_URL=https://res.cloudinary.com/dwjwrng2b/image/upload/v1786552657/full_logo_no_bg_eqgkg0.png
