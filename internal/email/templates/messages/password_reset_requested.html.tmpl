{{define "content"}}<p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#1a2023;">Hi {{.RecipientName}},</p>
<p style="margin:0;font-size:15px;line-height:1.65;color:#1a2023;">We received a request to reset the password for your {{.AppName}} account.</p>
{{template "button" .}}
<div style="margin:24px 0 0;padding:14px 16px;background:#ffe7c7;border-radius:6px;color:#6f4200;font-size:13px;line-height:1.6;">This link expires on <strong>{{formatTime .ExpiresAt}}</strong> and can only be used once.</div>
<p style="margin:22px 0 0;color:#798285;font-size:13px;line-height:1.6;">If you did not request a password reset, ignore this email. Your password will remain unchanged. Contact support if you believe someone is attempting to access your account.</p>{{end}}
