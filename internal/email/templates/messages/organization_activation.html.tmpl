{{define "content"}}<p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#1a2023;">Hi {{.RecipientName}},</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#1a2023;">Your organization, <strong>{{.OrganizationName}}</strong>, has been registered on {{.AppName}}.</p>
<p style="margin:0;font-size:15px;line-height:1.65;color:#1a2023;">Activate the organization and create your administrator credentials using the button below.</p>
{{template "button" .}}
<div style="margin:24px 0 0;padding:14px 16px;background:#e3efff;border-radius:6px;color:#515a5d;font-size:13px;line-height:1.6;">This link expires on <strong>{{formatTime .ExpiresAt}}</strong> and can only be used once.</div>
<p style="margin:22px 0 0;color:#798285;font-size:13px;line-height:1.6;">If you did not register this organization, contact support immediately.</p>{{end}}
